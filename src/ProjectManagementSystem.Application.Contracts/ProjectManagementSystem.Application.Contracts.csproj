<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
    <!-- protobuf-net.Grpc alone resolves protobuf-net 2.4, which cannot serialize DateOnly. -->
    <PackageReference Include="protobuf-net" Version="3.4.40" />
    <PackageReference Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectManagementSystem.Domain.Shared\ProjectManagementSystem.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
