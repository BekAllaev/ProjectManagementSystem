<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.84.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="MudBlazor" Version="9.*" />
    <PackageReference Include="protobuf-net.Grpc" Version="1.3.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client calls the API through the same service interfaces and messages the API implements. -->
    <ProjectReference Include="..\..\ProjectManagementSystem.Application.Contracts\ProjectManagementSystem.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- protobuf-net finds the members of the messages and the methods of the services by reflection at run time,
         so the trimmer of a published client must keep them. -->
    <TrimmerRootAssembly Include="ProjectManagementSystem.Application.Contracts" />
    <TrimmerRootAssembly Include="ProjectManagementSystem.Domain.Shared" />
  </ItemGroup>

</Project>
