@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Sign in · ProjectFlow</PageTitle>

<MudStack Spacing="0" Class="pf-login-page">
    <Brand />

    <MudStack Spacing="5" Justify="Justify.Center" Class="flex-grow-1 py-12 pf-login">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h3" HtmlTag="h1">Sign in</MudText>
            <MudText Typo="Typo.body1" Class="pf-muted">Use your work account to continue.</MudText>
        </MudStack>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true">@_error</MudAlert>
        }

        <EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="login">
            <DataAnnotationsValidator />
            <MudStack Spacing="4">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2" HtmlTag="label" for="login-email" Class="pf-field-label">Email</MudText>
                    <MudTextField @bind-Value="_model.Email" For="() => _model.Email" InputId="login-email"
                                  Placeholder="name@company.com" InputType="InputType.Email" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" AutoFocus="true" Disabled="_busy" autocomplete="username" Class="pf-input" />
                </MudStack>

                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2" HtmlTag="label" for="login-password" Class="pf-field-label">Password</MudText>
                    <MudTextField @bind-Value="_model.Password" For="() => _model.Password" InputId="login-password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Disabled="_busy" autocomplete="current-password" Class="pf-input"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                  OnAdornmentClick="() => _showPassword = !_showPassword"
                                  AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")" />
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudCheckBox @bind-Value="_model.RememberMe" Label="Keep me signed in" Color="Color.Primary" Dense="true"
                                 Disabled="_busy" Class="ml-n1" />
                    <MudLink Typo="Typo.body2" OnClick="() => _showResetHint = !_showResetHint" Class="pf-link">Forgot password?</MudLink>
                </MudStack>

                @if (_showResetHint)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                        Passwords are reset by your administrator. Ask them for a new one.
                    </MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           Disabled="_busy" Class="mt-1 pf-submit">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mr-2" Style="width:16px;height:16px" />
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Sign in</span>
                    }
                </MudButton>
            </MudStack>
        </EditForm>
    </MudStack>

    <MudText Typo="Typo.body2" Class="pf-muted">© @DateTime.Now.Year ProjectFlow</MudText>
</MudStack>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private readonly LoginModel _model = new() { RememberMe = true };
    private bool _busy;
    private bool _showPassword;
    private bool _showResetHint;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Signed in already: nothing to do here.
        if ((await AuthenticationState).User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.LoginAsync(_model.Email.Trim(), _model.Password, _model.RememberMe);

        _busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
            return;
        }

        _model.Password = string.Empty;
        _error = result.Failure switch
        {
            LoginFailure.InvalidCredentials => "The email or the password is wrong.",
            LoginFailure.LockedOut => "Too many failed attempts. The account is locked for a few minutes.",
            LoginFailure.ServerUnreachable => "The server cannot be reached. Check that the API is running and try again.",
            _ => "Signing in failed on the server. Try again later.",
        };
    }

    /// <summary>
    /// Only a path of this app, so a crafted link cannot send the user to another site after signing in.
    /// </summary>
    private string SafeReturnUrl() =>
        ReturnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") &&
        !url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "This is not an email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
