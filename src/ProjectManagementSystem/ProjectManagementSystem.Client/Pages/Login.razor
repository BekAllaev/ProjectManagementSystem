@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Sign in · ProjectFlow</PageTitle>

<div class="pf-login-page">
    <header class="pf-brand pf-login-brand">
        <span class="pf-brand-mark"></span>
        <span class="pf-brand-name">ProjectFlow</span>
    </header>

    <main class="pf-login">
        <div class="pf-login-heading">
            <h1 class="pf-login-title">Sign in</h1>
            <p class="pf-login-subtitle">Use your work account to continue.</p>
        </div>

        @if (_error is not null)
        {
            <div class="pf-login-error" role="alert">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" />
                <span>@_error</span>
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="login" class="pf-login-form">
            <DataAnnotationsValidator />

            <div class="pf-field">
                <label for="login-email">Email</label>
                <InputText id="login-email" type="email" class="pf-input" placeholder="name@company.com"
                           autocomplete="username" autofocus @bind-Value="_model.Email" disabled="@_busy" />
                <ValidationMessage For="() => _model.Email" class="pf-field-error" />
            </div>

            <div class="pf-field">
                <label for="login-password">Password</label>
                <div class="pf-input-wrap">
                    <InputText id="login-password" type="@(_showPassword ? "text" : "password")" class="pf-input pf-input-with-action"
                               autocomplete="current-password" @bind-Value="_model.Password" disabled="@_busy" />
                    <button type="button" class="pf-input-action" @onclick="() => _showPassword = !_showPassword"
                            aria-label="@(_showPassword ? "Hide password" : "Show password")">
                        <MudIcon Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" Size="Size.Small" />
                    </button>
                </div>
                <ValidationMessage For="() => _model.Password" class="pf-field-error" />
            </div>

            <div class="pf-login-options">
                <label class="pf-checkbox">
                    <InputCheckbox @bind-Value="_model.RememberMe" disabled="@_busy" />
                    <span>Keep me signed in</span>
                </label>
                <button type="button" class="pf-link-button" @onclick="() => _showResetHint = !_showResetHint">Forgot password?</button>
            </div>

            @if (_showResetHint)
            {
                <div class="pf-login-hint">Passwords are reset by your administrator. Ask them for a new one.</div>
            }

            <button type="submit" class="pf-btn pf-btn-primary pf-btn-block" disabled="@_busy">
                @if (_busy)
                {
                    <span class="pf-spinner" aria-hidden="true"></span>
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign in</span>
                }
            </button>
        </EditForm>
    </main>

    <footer class="pf-login-footer">© @DateTime.Now.Year ProjectFlow</footer>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private readonly LoginModel _model = new() { RememberMe = true };
    private bool _busy;
    private bool _showPassword;
    private bool _showResetHint;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Signed in already: nothing to do here.
        if ((await AuthenticationState).User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.LoginAsync(_model.Email.Trim(), _model.Password, _model.RememberMe);

        _busy = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
            return;
        }

        _model.Password = string.Empty;
        _error = result.Failure switch
        {
            LoginFailure.InvalidCredentials => "The email or the password is wrong.",
            LoginFailure.LockedOut => "Too many failed attempts. The account is locked for a few minutes.",
            LoginFailure.ServerUnreachable => "The server cannot be reached. Check that the API is running and try again.",
            _ => "Signing in failed on the server. Try again later.",
        };
    }

    /// <summary>
    /// Only a path of this app, so a crafted link cannot send the user to another site after signing in.
    /// </summary>
    private string SafeReturnUrl() =>
        ReturnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") &&
        !url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "This is not an email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
