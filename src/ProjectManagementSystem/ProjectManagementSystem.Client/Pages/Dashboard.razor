@page "/"
@using ProjectManagementSystem.Application.Dashboard
@using ProjectManagementSystem.Application.Dashboard.Queries.GetDashboard
@using ProjectManagementSystem.Application.Notifications
@using ProjectManagementSystem.Application.Notifications.Queries.GetNotifications
@inject IDashboardService DashboardService
@inject INotificationService NotificationService

<PageTitle>Dashboard · ProjectFlow</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 pf-breadcrumbs" />

<MudStack Row="true" AlignItems="AlignItems.Start" Class="mb-1">
    <MudStack Spacing="0" Class="flex-grow-1">
        <MudText Typo="Typo.h3" HtmlTag="h1">Dashboard</MudText>
        <MudText Typo="Typo.body2" Class="pf-muted">@Display.Date(DateTime.Now)</MudText>
    </MudStack>
    <MudTooltip Text="Refresh">
        <MudIconButton Icon="@Icons.Material.Rounded.Refresh" OnClick="LoadAsync" Disabled="_loading" aria-label="Refresh" />
    </MudTooltip>
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" ContentAlignment="HorizontalAlignment.Start">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <span>The dashboard could not be loaded. @_error</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync">Try again</MudButton>
        </MudStack>
    </MudAlert>
}

<MudGrid Spacing="4">
    <MudItem xs="12" lg="6">
        <DashboardCard Title="My open tasks" Loading="_loading">
            <Actions>
                @if (_dashboard is not null)
                {
                    <MudChip T="string" Size="Size.Small" Class="ma-0 pf-chip">@_dashboard.OpenTasks.Count</MudChip>
                }
            </Actions>
            <ChildContent>
                @if (_dashboard is null)
                {
                    <SkeletonRows Count="4" />
                }
                else if (_dashboard.OpenTasks.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.TaskAlt" Title="No open tasks" Text="Tasks you are responsible for show up here." />
                }
                else
                {
                    <MudStack Spacing="0">
                        @foreach (var task in _dashboard.OpenTasks)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="pf-row">
                                <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0">
                                    <MudText Typo="Typo.body2" Truncate="true">@task.Name</MudText>
                                    <MudText Typo="Typo.caption" Truncate="true" Class="pf-muted">@task.ProjectTitle · @task.WorkPackageDescription</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Class="pf-muted text-nowrap">@Display.Hours(task.LoggedHours) / @Display.Hours(task.EstimatedEffort)</MudText>
                                <StatusChipView Value="Display.Chip(task.Status)" />
                            </MudStack>
                        }
                    </MudStack>
                }
            </ChildContent>
        </DashboardCard>
    </MudItem>

    <MudItem xs="12" lg="6">
        <DashboardCard Title="My projects" Loading="_loading">
            @if (_dashboard is null)
            {
                <SkeletonRows Count="3" />
            }
            else if (_dashboard.Projects.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.FolderOff" Title="No projects" Text="Projects whose team you are a member of show up here." />
            }
            else
            {
                <MudStack Spacing="4">
                    @foreach (var project in _dashboard.Projects)
                    {
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.body2" Truncate="true" Class="flex-grow-1">@project.Title</MudText>
                                <StatusChipView Value="Display.Chip(project.State)" />
                                <MudText Typo="Typo.body2" Align="Align.Right" Class="pf-percent">@project.ProgressPercent%</MudText>
                            </MudStack>
                            <MudProgressLinear Color="Color.Primary" Value="Math.Clamp(project.ProgressPercent, 0, 100)" Rounded="true" Size="Size.Small" />
                        </MudStack>
                    }
                </MudStack>
            }
        </DashboardCard>
    </MudItem>

    <MudItem xs="12" lg="6">
        <DashboardCard Title="Funding status" Loading="_loading">
            @if (_dashboard is null)
            {
                <SkeletonRows Count="2" />
            }
            else if (_dashboard.FundingAlerts.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Savings" Title="Funding is on track"
                            Text="Projects that used 80% of their funding or more show up here." />
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var alert in _dashboard.FundingAlerts)
                    {
                        <MudAlert Severity="@(alert.IsOverspent ? Severity.Error : Severity.Warning)" Variant="Variant.Text" Dense="true"
                                  ContentAlignment="HorizontalAlignment.Start" Class="pf-funding">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                                <MudStack Spacing="0" Class="flex-grow-1">
                                    <MudText Typo="Typo.body2" Class="pf-funding-title">@FundingTitle(alert)</MudText>
                                    <MudText Typo="Typo.caption" Class="pf-muted">@FundingText(alert)</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="text-nowrap pf-funding-amount">@FundingAmount(alert)</MudText>
                            </MudStack>
                        </MudAlert>
                    }
                </MudStack>
            }
        </DashboardCard>
    </MudItem>

    <MudItem xs="12" lg="6">
        <DashboardCard Title="Recent notifications" Loading="_loading">
            <Actions>
                @if (_notifications is { UnreadCount: > 0 })
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ma-0 pf-chip">@_notifications.UnreadCount unread</MudChip>
                }
            </Actions>
            <ChildContent>
                @if (_notifications is null)
                {
                    <SkeletonRows Count="3" />
                }
                else if (_notifications.Items.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.NotificationsOff" Title="No notifications"
                                Text="New problems with your work show up here." />
                }
                else
                {
                    <MudStack Spacing="0">
                        @foreach (var notification in _notifications.Items)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3" Class="pf-row">
                                <span class="pf-dot @(notification.IsRead ? string.Empty : "pf-dot-unread")"></span>
                                <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0">
                                    <MudText Typo="Typo.body2" Class="@(notification.IsRead ? "pf-read" : string.Empty)">@notification.Title</MudText>
                                    <MudText Typo="Typo.caption" Class="pf-muted">@notification.ProjectTitle · @Display.Ago(notification.CreatedAt, DateTime.UtcNow)</MudText>
                                </MudStack>
                            </MudStack>
                        }
                    </MudStack>
                }
            </ChildContent>
        </DashboardCard>
    </MudItem>
</MudGrid>

@code {
    private const int RecentNotifications = 5;

    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", href: null, disabled: true)];

    private MyDashboard? _dashboard;
    private NotificationList? _notifications;
    private bool _loading;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        // Both calls go out at once; each card shows its data as soon as it is there.
        var dashboard = DashboardService.GetDashboard(new GetDashboardQuery());
        var notifications = NotificationService.GetNotifications(new GetNotificationsQuery(UnreadOnly: false, Take: RecentNotifications));

        try
        {
            _dashboard = await dashboard;
            _notifications = await notifications;
        }
        catch (Exception exception)
        {
            _error = GrpcErrors.Describe(exception);
            await ObserveAsync(notifications);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// The other call of a failed load, so its outcome is not lost and its exception not left unobserved.
    /// </summary>
    private async Task ObserveAsync(Task<NotificationList> notifications)
    {
        try
        {
            _notifications = await notifications;
        }
        catch (Exception)
        {
            // Already reported by the first failure.
        }
    }

    private static string FundingTitle(FundingAlertItem alert) =>
        alert.IsOverspent
            ? $"{alert.ProjectTitle} is overspent"
            : $"{alert.ProjectTitle} has used {alert.UsedPercent?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string FundingText(FundingAlertItem alert) =>
        alert.IsOverspent
            ? $"Actual cost exceeds total funding of {Display.Money(alert.TotalFunding, alert.Currency)}"
            : $"{Display.Money(alert.ActualCost, alert.Currency)} of {Display.Money(alert.TotalFunding, alert.Currency)} funding spent";

    private static string FundingAmount(FundingAlertItem alert) =>
        alert.IsOverspent
            ? Display.Money(alert.RemainingFunding, alert.Currency)
            : $"{Display.Money(alert.RemainingFunding, alert.Currency)} left";
}
