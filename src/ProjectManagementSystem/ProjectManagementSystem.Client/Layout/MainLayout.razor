@inherits LayoutComponentBase

<MudProviders />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <AppHeader OnToggleNavigation="ToggleDrawer" />
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive"
                       Elevation="0" Class="pf-drawer">
                <NavMenu />
            </MudDrawer>
            <MudMainContent>
                <div class="pf-page">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @* Every page of the shell needs a signed-in user; pages open to everyone use AuthLayout (the login page). *@
        <RedirectToLogin />
    </NotAuthorized>
    <Authorizing>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    </Authorizing>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
