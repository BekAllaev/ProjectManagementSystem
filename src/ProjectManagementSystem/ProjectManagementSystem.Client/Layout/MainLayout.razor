@inherits LayoutComponentBase

<MudProviders />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <AppHeader OnToggleNavigation="ToggleDrawer" />
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive"
                       Elevation="0" Class="pf-drawer">
                <NavMenu />
            </MudDrawer>
            <MudMainContent>
                <div class="pf-page">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @* A page open to everyone (the 404 page), or the redirect to the login page. *@
        <div class="pf-auth-page">@Body</div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
