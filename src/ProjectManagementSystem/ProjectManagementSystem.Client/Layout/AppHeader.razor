@using ProjectManagementSystem.Application.Employees
@using ProjectManagementSystem.Application.Employees.Queries.GetCurrentEmployee
@using ProjectManagementSystem.Application.Notifications
@using ProjectManagementSystem.Application.Notifications.Queries.GetNotifications
@inject IEmployeeService Employees
@inject INotificationService Notifications
@inject AuthService Auth
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@inject NotificationEvents NotificationEvents
@implements IDisposable

@* The bar at the top of the shell: navigation toggle, brand, unread notifications and the menu of the user. *@
<MudAppBar Elevation="0" Class="pf-appbar" Gutters="false">
    <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" OnClick="OnToggleNavigation" aria-label="Toggle navigation" />
    <Brand Href="" />

    <MudSpacer />

    <MudTooltip Text="@(_unreadCount == 1 ? "1 unread notification" : $"{_unreadCount} unread notifications")">
        <MudBadge Content="_unreadCount" Visible="_unreadCount > 0" Max="99" Color="Color.Primary" Overlap="true" Class="pf-bell">
            <MudIconButton Href="notifications" Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" aria-label="Notifications" />
        </MudBadge>
    </MudTooltip>

    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" PopoverClass="pf-user-menu" Class="ml-1">
        <ActivatorContent>
            @* A custom activator opens the menu itself (MudBlazor 9). *@
            <MudButton OnClick="@context.ToggleAsync" Variant="Variant.Text" Color="Color.Inherit"
                       EndIcon="@Icons.Material.Rounded.ExpandMore" Class="pf-user-button" aria-label="Account menu">
                <MudAvatar Size="Size.Small" Class="pf-avatar">@_initials</MudAvatar>
                <MudText Typo="Typo.body2" Class="d-none d-sm-flex ml-2">@_displayName</MudText>
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudStack Spacing="0" Class="px-4 pt-2 pb-3">
                <MudText Typo="Typo.body2">@_displayName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pf-muted">@_email</MudText>
            </MudStack>
            <MudDivider Class="mb-1" />
            @* Profile comes with its own page. *@
            <MudMenuItem Icon="@Icons.Material.Outlined.Person" Disabled="true">Profile</MudMenuItem>
            <MudMenuItem Icon="@(ThemeService.IsDarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)"
                         OnClick="ToggleThemeAsync" AutoClose="false">
                Theme: @(ThemeService.IsDarkMode ? "Dark" : "Light")
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">Sign out</MudMenuItem>
        </ChildContent>
    </MudMenu>
</MudAppBar>

@code {
    [Parameter]
    public EventCallback OnToggleNavigation { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _initials = string.Empty;
    private int _unreadCount;

    protected override async Task OnInitializedAsync()
    {
        // Until the employee arrives, the header shows the email of the sign-in.
        var user = (await AuthenticationState).User;
        _email = _displayName = user.Identity?.Name ?? string.Empty;
        _initials = _email.Length > 0 ? _email[..1].ToUpperInvariant() : "?";

        NotificationEvents.Changed += OnNotificationsChanged;

        var employee = LoadEmployeeAsync();
        var unread = LoadUnreadCountAsync();
        await Task.WhenAll(employee, unread);
    }

    private async Task LoadEmployeeAsync()
    {
        try
        {
            var employee = await Employees.GetCurrentEmployee(new GetCurrentEmployeeQuery());
            _displayName = $"{employee.FirstName} {employee.LastName}";
            _email = employee.Email;
            _initials = Display.Initials(employee.FirstName, employee.LastName);
        }
        catch (Exception)
        {
            // The header keeps the email; the page shows the error of its own calls.
        }
    }

    private async Task LoadUnreadCountAsync()
    {
        try
        {
            // UnreadCount counts every unread notification, whatever Take is.
            var notifications = await Notifications.GetNotifications(new GetNotificationsQuery(UnreadOnly: true, Take: 1));
            _unreadCount = notifications.UnreadCount;
        }
        catch (Exception)
        {
            _unreadCount = 0;
        }
    }

    private void OnNotificationsChanged() => InvokeAsync(async () =>
    {
        await LoadUnreadCountAsync();
        StateHasChanged();
    });

    private Task ToggleThemeAsync() => ThemeService.SetDarkModeAsync(!ThemeService.IsDarkMode);

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }

    public void Dispose() => NotificationEvents.Changed -= OnNotificationsChanged;
}
