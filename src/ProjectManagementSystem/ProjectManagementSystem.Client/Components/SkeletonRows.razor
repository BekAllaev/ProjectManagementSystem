<div class="pf-list">
    @for (var i = 0; i < Count; i++)
    {
        <div class="pf-row">
            <div class="pf-row-main">
                <MudSkeleton Width="70%" />
                <MudSkeleton Width="45%" Height="14px" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Count { get; set; } = 3;
}
