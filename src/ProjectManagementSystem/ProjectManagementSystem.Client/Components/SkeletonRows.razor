<MudStack Spacing="3" Class="py-2">
    @for (var i = 0; i < Count; i++)
    {
        <MudStack Spacing="1">
            <MudSkeleton Width="70%" />
            <MudSkeleton Width="45%" Height="14px" />
        </MudStack>
    }
</MudStack>

@code {
    [Parameter]
    public int Count { get; set; } = 3;
}
