@using ProjectManagementSystem.Application.Employees
@using ProjectManagementSystem.Application.Employees.Commands.RegisterEmployee
@inject IEmployeeService EmployeeService

@* Registers an employee. The API rejects an email another employee already has; the dialog then stays open with the
   reason, so the input is not lost. Closes with the full name of the new employee. *@
<MudDialog Class="pf-dialog">
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="3">
                <MudTextField T="string" @bind-Value="_firstName" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="Enter the first name." MaxLength="100" AutoFocus="true" Immediate="true" />
                <MudTextField T="string" @bind-Value="_lastName" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="Enter the last name." MaxLength="100" Immediate="true" />
                <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Placeholder="name@projectflow.io"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Enter the email."
                              Validation="@(new System.ComponentModel.DataAnnotations.EmailAddressAttribute { ErrorMessage = "Enter a valid email." })"
                              MaxLength="254" Immediate="true" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" ContentAlignment="HorizontalAlignment.Start">@_error</MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="_saving">
            @(_saving ? "Creating…" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm _form = default!;
    private bool _valid;
    private bool _saving;
    private string? _firstName;
    private string? _lastName;
    private string? _email;
    private string? _error;

    private void Cancel() => Dialog.Cancel();

    private async Task CreateAsync()
    {
        await _form.ValidateAsync();
        if (!_valid)
            return;

        _saving = true;
        _error = null;

        try
        {
            var firstName = _firstName!.Trim();
            var lastName = _lastName!.Trim();
            await EmployeeService.RegisterEmployee(new RegisterEmployeeCommand(firstName, lastName, _email!.Trim()));
            Dialog.Close(DialogResult.Ok($"{firstName} {lastName}"));
        }
        catch (Exception exception)
        {
            _error = GrpcErrors.Describe(exception);
        }
        finally
        {
            _saving = false;
        }
    }
}
