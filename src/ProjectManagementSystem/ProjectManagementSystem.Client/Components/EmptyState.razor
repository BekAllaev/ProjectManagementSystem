<MudStack Spacing="1" AlignItems="AlignItems.Start" Class="pt-4 pb-2">
    <MudIcon Icon="@Icon" Class="pf-empty-icon mb-1" />
    <MudText Typo="Typo.body2">@Title</MudText>
    @if (Text is not null)
    {
        <MudText Typo="Typo.caption" Class="pf-muted">@Text</MudText>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    [Parameter]
    public string? Text { get; set; }
}
