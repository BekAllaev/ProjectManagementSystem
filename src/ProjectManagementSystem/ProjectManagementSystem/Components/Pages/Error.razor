@page "/Error"
@layout AuthLayout
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

<PageTitle>Error · ProjectFlow</PageTitle>

<div class="pf-stack" style="max-width:640px;margin:12vh auto 0">
    <h1 class="pf-page-title">Something went wrong</h1>
    <div class="pf-muted">An error occurred while processing your request.</div>

    @if (ShowRequestId)
    {
        <div class="pf-muted">Request ID: <code>@RequestId</code></div>
    }

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/">Go to the dashboard</MudButton>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
