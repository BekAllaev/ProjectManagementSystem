<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* The theme the user chose (ThemeService), set before anything paints, so a light page never flashes dark. *@
    <script>try { if (localStorage.getItem("pms.theme") === "light") document.documentElement.setAttribute("data-theme", "light"); } catch { }</script>
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/ico" href="favicon.ico" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    /// <summary>
    /// The whole app runs in the browser (WebAssembly), which calls the API itself with the token of the user. It is
    /// not prerendered: the server knows nothing about the user, whose token lives in the storage of the browser.
    /// The error page alone renders statically on the server.
    /// </summary>
    private static readonly IComponentRenderMode Interactive = new InteractiveWebAssemblyRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? Interactive : null;
}
